{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mediaremote.local/schemas/state.schema.json",
  "title": "MediaRemoteState",
  "description": "Authoritative media session state broadcast from Android receiver.",
  "type": "object",
  "required": [
    "deviceId",
    "deviceName",
    "packageName",
    "playbackState",
    "supportedActions",
    "volume",
    "sessions"
  ],
  "additionalProperties": false,
  "properties": {
    "deviceId": { "type": "string", "minLength": 1 },
    "deviceName": { "type": "string", "minLength": 1 },
    "sessionId": { "type": ["string", "null"] },
    "packageName": { "type": ["string", "null"] },
    "appName": { "type": ["string", "null"] },
    "appIconB64": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "artist": { "type": ["string", "null"] },
    "album": { "type": ["string", "null"] },
    "durationMs": { "type": ["integer", "null"], "minimum": 0 },
    "positionMs": { "type": ["integer", "null"], "minimum": 0 },
    "playbackState": {
      "type": "string",
      "enum": ["NONE", "STOPPED", "PAUSED", "PLAYING", "BUFFERING", "ERROR"]
    },
    "isLastPlayed": { "type": "boolean" },
    "supportedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["play", "pause", "stop", "next", "previous"]
      },
      "uniqueItems": true
    },
    "artworkBase64": { "type": ["string", "null"] },
    "artworkHash": { "type": ["string", "null"] },
    "volume": {
      "type": "object",
      "required": ["current", "max", "percent", "isFixed"],
      "additionalProperties": false,
      "properties": {
        "current": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "isFixed": { "type": "boolean" }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sessionId", "packageName", "appName", "playbackState", "isSelected"],
        "additionalProperties": false,
        "properties": {
          "sessionId": { "type": "string", "minLength": 1 },
          "packageName": { "type": "string", "minLength": 1 },
          "appName": { "type": ["string", "null"] },
          "appIconB64": { "type": ["string", "null"] },
          "title": { "type": ["string", "null"] },
          "playbackState": {
            "type": "string",
            "enum": ["NONE", "STOPPED", "PAUSED", "PLAYING", "BUFFERING", "ERROR"]
          },
          "isSelected": { "type": "boolean" }
        }
      }
    }
  }
}
