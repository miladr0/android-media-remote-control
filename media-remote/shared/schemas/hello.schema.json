{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mediaremote.local/schemas/hello.schema.json",
  "title": "MediaRemoteHello",
  "description": "Protocol version negotiation payloads (hello and hello_ack).",
  "oneOf": [
    {
      "type": "object",
      "required": ["clientId", "clientName", "supportedVersions"],
      "additionalProperties": false,
      "properties": {
        "clientId": { "type": "string", "minLength": 8, "maxLength": 64 },
        "clientName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "supportedVersions": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1
        }
      }
    },
    {
      "type": "object",
      "required": ["selectedVersion", "deviceId", "deviceName", "requiresPairing", "serverTime"],
      "additionalProperties": false,
      "properties": {
        "selectedVersion": { "type": "integer", "const": 1 },
        "deviceId": { "type": "string", "minLength": 8, "maxLength": 64 },
        "deviceName": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requiresPairing": { "type": "boolean" },
        "serverTime": { "type": "integer", "minimum": 1700000000000 }
      }
    }
  ]
}
