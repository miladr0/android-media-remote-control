#!/bin/sh
#
# Gradle start up script for POSIX generated wrapper.
# Note: Requires gradle/wrapper/gradle-wrapper.jar or a local Gradle installation synced by Android Studio.
#
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$CLASSPATH" ]; then
  if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
  fi
  echo "gradle-wrapper.jar not found. Open the project in Android Studio to sync the Gradle wrapper, or run 'gradle wrapper'." >&2
  exit 1
fi

exec java -Xmx64m -Xms64m -Dorg.gradle.appname=gradlew -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
